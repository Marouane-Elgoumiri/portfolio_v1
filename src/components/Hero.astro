---
---

<section class="min-h-screen flex items-center justify-center px-6 pt-16 relative overflow-hidden" id="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-gradient"></div>
    <div class="hero-grid"></div>
    <div class="hero-orb" style="width:300px;height:300px;top:15%;left:5%;--d:18s;"></div>
    <div class="hero-orb" style="width:200px;height:200px;top:60%;right:8%;--d:22s;"></div>
    <div class="hero-orb" style="width:250px;height:250px;top:80%;left:40%;--d:15s;"></div>
    <div class="hero-glyphs">
      <span style="--d:0;--x:8%;--y:12%;--s:18s">{</span>
      <span style="--d:-4s;--x:22%;--y:75%;--s:22s">❯</span>
      <span style="--d:-8s;--x:45%;--y:20%;--s:20s">=></span>
      <span style="--d:-12s;--x:70%;--y:85%;--s:24s">fn</span>
      <span style="--d:-2s;--x:88%;--y:30%;--s:19s">}</span>
      <span style="--d:-6s;--x:15%;--y:45%;--s:21s">//</span>
      <span style="--d:-10s;--x:55%;--y:60%;--s:25s">[]</span>
      <span style="--d:-14s;--x:78%;--y:10%;--s:17s">;</span>
      <span style="--d:-3s;--x:35%;--y:90%;--s:23s">::</span>
      <span style="--d:-9s;--x:92%;--y:55%;--s:20s">|></span>
      <span style="--d:-15s;--x:5%;--y:65%;--s:26s">&&</span>
      <span style="--d:-7s;--x:60%;--y:40%;--s:22s">..</span>
      <span style="--d:-1s;--x:40%;--y:5%;--s:16s">async</span>
      <span style="--d:-5s;--x:75%;--y:50%;--s:19s">match</span>
      <span style="--d:-11s;--x:30%;--y:55%;--s:21s">impl</span>
      <span style="--d:-13s;--x:85%;--y:15%;--s:23s">pub</span>
    </div>
    <div class="hero-beam" style="left:10%;top:0;--d:8s;--delay:0s;"></div>
    <div class="hero-beam" style="left:30%;top:0;--d:10s;--delay:-3s;"></div>
    <div class="hero-beam" style="left:55%;top:0;--d:7s;--delay:-5s;"></div>
    <div class="hero-beam" style="left:75%;top:0;--d:12s;--delay:-2s;"></div>
    <div class="hero-beam" style="left:92%;top:0;--d:9s;--delay:-7s;"></div>
    <div class="hero-ring" style="--d:4s;"></div>
    <div class="hero-ring" style="--d:6s;"></div>
    <div class="hero-ring" style="--d:8s;"></div>
  </div>

  <div class="hero-mono hidden md:block" aria-hidden="true">MR1</div>

  <div class="max-w-4xl w-full relative z-10">
    <div class="terminal-window glow">
      <div class="terminal-header">
        <span class="terminal-dot terminal-dot-red"></span>
        <span class="terminal-dot terminal-dot-yellow"></span>
        <span class="terminal-dot terminal-dot-green"></span>
        <span class="terminal-title">portfolio — bash — 80x24</span>
      </div>
      <div class="terminal-body">
        <div class="mb-2 text-text-muted text-base">
          Last login: <span id="hero-date"></span> on ttys001
          <span class="ml-3">TZ: GMT+1</span>
        </div>
        <div class="mb-3">
          <span class="prompt">❯ </span>
          <span class="command" id="typed-text"></span>
          <span class="cursor"></span>
        </div>
        <div id="hero-output" class="opacity-0 transition-opacity duration-500">
          <div class="mb-1">
            <span class="text-accent font-semibold text-lg">Hello, I'm</span>
            <span class="text-text-primary font-semibold text-2xl ml-2">Marwan</span>
          </div>
          <div class="output mb-3">A developer who builds and creates solutions.</div>
          <div class="flex flex-wrap gap-2 mt-4">
            <a
              href="#projects"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent text-bg-primary font-mono text-base font-semibold rounded hover:brightness-110 transition-all"
            >
              <span>ls</span>
              <span class="text-bg-primary/60">~/projects</span>
            </a>
            <a
              href="#contact"
              class="inline-flex items-center gap-2 px-5 py-2.5 border border-accent text-accent font-mono text-base font-semibold rounded hover:bg-accent/10 transition-all"
            >
              <span>mail</span>
              <span class="text-accent/60">--send</span>
            </a>
            <a
              href="/RESUME.pdf"
              download
              class="inline-flex items-center gap-2 px-5 py-2.5 border border-border text-text-secondary font-mono text-base font-semibold rounded hover:border-accent hover:text-accent transition-all"
            >
              <span>cat</span>
              <span class="text-text-muted">resume.pdf</span>
              <span class="text-accent">|</span>
              <span>download</span>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-6 text-center font-mono text-sm text-text-muted">
      scroll down to explore ↓
    </div>
  </div>
</section>

<script>
  const text = "cat ~/portfolio/intro.md";
  const el = document.getElementById("typed-text");
  const output = document.getElementById("hero-output");
  const dateEl = document.getElementById("hero-date");

  if (dateEl) {
    const now = new Date();
    const pad = (n: number) => String(n).padStart(2, "0");
    dateEl.textContent = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())} CET`;
  }

  if (el && output) {
    let i = 0;
    const type = () => {
      if (i < text.length) {
        el.textContent += text[i];
        i++;
        setTimeout(type, 60 + Math.random() * 80);
      } else {
        setTimeout(() => {
          output.style.opacity = "1";
        }, 300);
      }
    };
    setTimeout(type, 800);
  }
</script>
