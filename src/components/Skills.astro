---
const languages = [
  { name: "Python", pct: 95, icon: "/Assets/tech/python.jpeg" },
  { name: "JavaScript", pct: 90, icon: "/Assets/tech/javascript.png" },
  { name: "Java", pct: 70, icon: "/Assets/tech/java.png" },
  { name: "C/C++", pct: 65, icon: "/Assets/tech/ISO_C++_Logo.svg.png" },
];

const frameworks = [
  { name: "React.js", pct: 95, icon: "/Assets/tech/React-icon.svg.png" },
  { name: "Django", pct: 85, icon: "/Assets/tech/django.png" },
  { name: "Node.js", pct: 80, icon: "/Assets/tech/nodejs.jpg" },
  { name: "SpringBoot", pct: 90, icon: "/Assets/tech/springboot.png" },
];

const cloud = [
  { name: "Azure", pct: 85, icon: "/Assets/tech/azure.png" },
  { name: "Docker", pct: 90, icon: "/Assets/tech/docker.png" },
  { name: "Git & GitHub", pct: 90, icon: "/Assets/tech/Git-and-GitHub.png" },
  { name: "Firebase", pct: 85, icon: "/Assets/tech/firebase.jpg" },
];

const databases = [
  { name: "PostgreSQL", pct: 90, icon: "/Assets/tech/postgres.png" },
  { name: "Redis", pct: 80, icon: "/Assets/tech/redis-logo.svg" },
  { name: "MongoDB", pct: 75, icon: "/Assets/tech/mongodb.png" },
];

const categories = [
  { label: "Languages", skills: languages },
  { label: "Frameworks", skills: frameworks },
  { label: "Cloud & DevOps", skills: cloud },
  { label: "Databases", skills: databases },
];
---

<section id="skills" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="reveal mb-8">
      <span class="prompt font-mono text-base">❯ </span>
      <span class="command font-mono text-base">neofetch --skills</span>
    </div>

    <div class="reveal terminal-window">
      <div class="terminal-header">
        <span class="terminal-dot terminal-dot-red"></span>
        <span class="terminal-dot terminal-dot-yellow"></span>
        <span class="terminal-dot terminal-dot-green"></span>
        <span class="terminal-title">neofetch</span>
      </div>
      <div class="terminal-body">
        <div class="grid md:grid-cols-2 gap-8">
          {categories.map((cat) => (
            <div>
              <span class="font-mono text-accent font-medium text-lg block mb-4">{cat.label}</span>
              <div class="space-y-3">
                {cat.skills.map((skill) => (
                  <div>
                    <div class="flex items-center justify-between text-sm font-mono mb-1">
                      <span class="flex items-center gap-2 text-text-secondary">
                        <img src={skill.icon} alt={skill.name} class="w-5 h-5 object-contain rounded-sm" loading="lazy" />
                        {skill.name}
                      </span>
                      <span class="text-text-muted">{skill.pct}%</span>
                    </div>
                    <div class="skill-bar">
                      <div
                        class="skill-bar-fill"
                        data-width={`${skill.pct}%`}
                      ></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
