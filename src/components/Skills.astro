---
const languages = [
  { name: "Python", icon: "/Assets/tech/python.jpeg" },
  { name: "JavaScript", icon: "/Assets/tech/javascript.png" },
  { name: "Java", icon: "/Assets/tech/java.png" },
  { name: "C/C++", icon: "/Assets/tech/ISO_C++_Logo.svg.png" },
];

const frameworks = [
  { name: "React.js", icon: "/Assets/tech/React-icon.svg.png" },
  { name: "Django", icon: "/Assets/tech/django.png" },
  { name: "Node.js", icon: "/Assets/tech/nodejs.jpg" },
  { name: "SpringBoot", icon: "/Assets/tech/springboot.png" },
];

const cloud = [
  { name: "Azure", icon: "/Assets/tech/azure.png" },
  { name: "Docker", icon: "/Assets/tech/docker.png" },
  { name: "Git & GitHub", icon: "/Assets/tech/Git-and-GitHub.png" },
  { name: "Firebase", icon: "/Assets/tech/firebase.jpg" },
];

const databases = [
  { name: "PostgreSQL", icon: "/Assets/tech/postgres.png" },
  { name: "Redis", icon: "/Assets/tech/redis-logo.svg" },
  { name: "MongoDB", icon: "/Assets/tech/mongodb.png" },
];

const categories = [
  { label: "Languages", skills: languages },
  { label: "Frameworks", skills: frameworks },
  { label: "Cloud & DevOps", skills: cloud },
  { label: "Databases", skills: databases },
];
---

<section id="skills" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="reveal mb-8">
      <span class="prompt font-mono text-base">❯ </span>
      <span class="command font-mono text-base">neofetch --skills</span>
    </div>

    <div class="reveal terminal-window">
      <div class="terminal-header">
        <span class="terminal-dot terminal-dot-red"></span>
        <span class="terminal-dot terminal-dot-yellow"></span>
        <span class="terminal-dot terminal-dot-green"></span>
        <span class="terminal-title">neofetch</span>
      </div>
      <div class="terminal-body">
        <div class="grid md:grid-cols-2 gap-8">
          {categories.map((cat) => (
            <div>
              <span class="font-mono text-accent font-medium text-lg block mb-4">{cat.label}</span>
              <div class="space-y-3">
                {cat.skills.map((skill) => (
                  <div class="flex items-center gap-2 text-base font-mono py-1">
                    <img src={skill.icon} alt={skill.name} class="w-5 h-5 object-contain rounded-sm" loading="lazy" />
                    <span class="text-text-secondary">{skill.name}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
